/* General Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #0b0b0f;
    color: white;
    line-height: 1.6;
}

html {
    scroll-behavior: smooth;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    width: 100%;
    display: block;
}

/* Navigation Bar */
header {
    background-color: #111116;
    padding: 20px 8%;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #292929;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 2px;
}

.logo span,
footer span {
    color: #e50914;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    font-size: 15px;
    color: #ddd;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #e50914;
}

/* Hero Section */
.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: 80px 8%;

    background:
        linear-gradient(
            90deg,
            #0b0b0f 10%,
            rgba(11, 11, 15, 0.85) 45%,
            rgba(11, 11, 15, 0.2) 100%
        ),
        url("https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 600px;
}

.tagline {
    color: #e50914;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 75px;
    line-height: 1.05;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.movie-info {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    color: #ccc;
    margin-bottom: 20px;
}

.description {
    color: #ddd;
    font-size: 16px;
    max-width: 500px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.btn {
    padding: 12px 25px;
    border-radius: 5px;
    font-weight: bold;
    transition: 0.3s;
}

.primary-btn {
    background-color: #e50914;
    color: white;
}

.primary-btn:hover {
    background-color: #b80710;
}

.secondary-btn {
    background-color: #ffffff;
    color: #111;
}

.secondary-btn:hover {
    background-color: #ccc;
}

/* Common Section Styles */
.section {
    padding: 70px 8%;
}

.section-title {
    font-size: 32px;
    margin-bottom: 35px;
    text-align: center;
}

.section-title span {
    color: #e50914;
}

/* Story Section */
.story-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    align-items: center;
}

.story-poster img {
    height: 400px;
    object-fit: cover;
    border-radius: 10px;
}

.story-content h3 {
    font-size: 27px;
    margin-bottom: 20px;
}

.story-content p {
    color: #bbb;
    margin-bottom: 15px;
}

.movie-details {
    margin-top: 25px;
    border-top: 1px solid #333;
    padding-top: 20px;
}

.movie-details strong {
    color: white;
}

/* Cast Section */
.cast-section {
    background-color: #111116;
}

.cast-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.cast-card {
    background-color: #1b1b22;
    border-radius: 10px;
    overflow: hidden;
    text-align: center;
    transition: transform 0.3s;
}

.cast-card:hover {
    transform: translateY(-8px);
}

.cast-card img {
    height: 280px;
    object-fit: cover;
}

.cast-card h3 {
    margin-top: 15px;
    font-size: 19px;
}

.cast-card p {
    color: #aaa;
    padding-bottom: 20px;
}

/* Rating Section */
.rating-section {
    padding: 50px 8%;
    text-align: center;
    background-color: #181820;
}

.rating-section h2 {
    font-size: 25px;
    margin-bottom: 15px;
}

.rating {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
}

.star {
    color: #ffc107;
    font-size: 35px;
}

.rating-number {
    font-size: 40px;
    font-weight: bold;
}

.rating-total {
    color: #aaa;
    font-size: 20px;
}

.rating-section p {
    color: #aaa;
    margin-top: 10px;
}

/* Trailer Section */
.trailer-box {
    max-width: 850px;
    margin: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 10px;
}

.trailer-box iframe {
    width: 100%;
    height: 100%;
    border: none;
}

/* Related Movies */
.related-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.related-card {
    background-color: #1b1b22;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s;
}

.related-card:hover {
    transform: translateY(-8px);
}

.related-card img {
    height: 250px;
    object-fit: cover;
}

.related-card h3 {
    padding: 15px 15px 5px;
}

.related-card p {
    padding: 0 15px 20px;
    color: #aaa;
}

/* Footer */
footer {
    background-color: #111116;
    padding: 40px 8%;
    text-align: center;
    border-top: 1px solid #292929;
}

footer h2 {
    font-size: 25px;
    margin-bottom: 10px;
}

footer p {
    color: #aaa;
}

.copyright {
    margin-top: 20px;
    font-size: 14px;
}

/* Tablet Responsive Design */
@media (max-width: 900px) {

    .hero h1 {
        font-size: 60px;
    }

    .cast-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .story-container {
        grid-template-columns: 1fr;
    }

    .story-poster img {
        height: 350px;
    }

}

/* Mobile Responsive Design */
@media (max-width: 600px) {

    header {
        padding: 15px 5%;
    }

    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .hero {
        min-height: 550px;
        padding: 50px 5%;
        background-position: center;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-content {
        width: 100%;
    }

    .description {
        font-size: 14px;
    }

    .section {
        padding: 50px 5%;
    }

    .section-title {
        font-size: 27px;
    }

    .cast-container {
        grid-template-columns: 1fr;
    }

    .cast-card img {
        height: 350px;
    }

    .related-container {
        grid-template-columns: 1fr;
    }

    .related-card img {
        height: 300px;
    }

    .story-poster img {
        height: 250px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

}
