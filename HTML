<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shadow Strike | Movie Website</title>

    <!-- Connect external CSS file -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <a href="#" class="logo">CINE<span>MAX</span></a>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#story">Story</a></li>
                <li><a href="#cast">Cast</a></li>
                <li><a href="#trailer">Trailer</a></li>
                <li><a href="#related">Movies</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main Movie Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <p class="tagline">CINEMAX ORIGINAL</p>

            <h1>SHADOW<br>STRIKE</h1>

            <div class="movie-info">
                <span>2026</span>
                <span>Action / Thriller</span>
                <span>2h 15m</span>
            </div>

            <p class="description">
                One mission. One chance. A city waiting to be saved.
                Enter the world of Shadow Strike, where every decision
                could change everything.
            </p>

            <div class="hero-buttons">
                <a href="#trailer" class="btn primary-btn">
                    ▶ Watch Trailer
                </a>

                <a href="#story" class="btn secondary-btn">
                    Explore Movie
                </a>
            </div>
        </div>
    </section>

    <!-- Story Section -->
    <section class="section" id="story">
        <h2 class="section-title">Movie <span>Story</span></h2>

        <div class="story-container">
            <div class="story-poster">
                <img
                    src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=700&q=80"
                    alt="Dark cinematic landscape"
                >
            </div>

            <div class="story-content">
                <h3>The Mission Begins</h3>

                <p>
                    When a mysterious organization threatens to destroy
                    the city, a former intelligence officer is forced
                    to return to the world he left behind.
                </p>

                <p>
                    With time running out, he must uncover the truth,
                    face his past, and stop a dangerous plan before
                    it is too late.
                </p>

                <div class="movie-details">
                    <p><strong>Director:</strong> Arjun Varma</p>
                    <p><strong>Genre:</strong> Action, Thriller</p>
                    <p><strong>Language:</strong> Telugu</p>
                    <p><strong>Release:</strong> 2026</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Cast Section -->
    <section class="section cast-section" id="cast">
        <h2 class="section-title">Meet The <span>Cast</span></h2>

        <div class="cast-container">

            <div class="cast-card">
                <img
                    src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=400&q=80"
                    alt="Actor playing the lead role"
                >
                <h3>Arjun Rao</h3>
                <p>Lead Actor</p>
            </div>

            <div class="cast-card">
                <img
                    src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80"
                    alt="Actress playing the female lead"
                >
                <h3>Meera Sharma</h3>
                <p>Female Lead</p>
            </div>

            <div class="cast-card">
                <img
                    src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=400&q=80"
                    alt="Actor playing the villain"
                >
                <h3>Vikram Dev</h3>
                <p>Antagonist</p>
            </div>

            <div class="cast-card">
                <img
                    src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=400&q=80"
                    alt="Actor playing a supporting role"
                >
                <h3>Riya Das</h3>
                <p>Supporting Role</p>
            </div>

        </div>
    </section>

    <!-- Rating Section -->
    <section class="rating-section">
        <h2>Audience Rating</h2>

        <div class="rating">
            <span class="star">★</span>
            <span class="rating-number">8.7</span>
            <span class="rating-total">/ 10</span>
        </div>

        <p>Based on audience reviews</p>
    </section>

    <!-- Trailer Section -->
    <section class="section trailer-section" id="trailer">
        <h2 class="section-title">Official <span>Trailer</span></h2>

        <div class="trailer-box">
            <iframe
                src="https://www.youtube.com/embed/ScMzIvxBSi4"
                title="Shadow Strike Movie Trailer"
                allowfullscreen>
            </iframe>
        </div>
    </section>

    <!-- Related Movies Section -->
    <section class="section" id="related">
        <h2 class="section-title">Related <span>Movies</span></h2>

        <div class="related-container">

            <div class="related-card">
                <img
                    src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=500&q=80"
                    alt="Night sky movie poster"
                >
                <h3>Dark Horizon</h3>
                <p>Action | 2025</p>
            </div>

            <div class="related-card">
                <img
                    src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=500&q=80"
                    alt="Mountain adventure movie poster"
                >
                <h3>Last Mission</h3>
                <p>Thriller | 2024</p>
            </div>

            <div class="related-card">
                <img
                    src="https://images.unsplash.com/photo-1478720568477-152d9b164e26?auto=format&fit=crop&w=500&q=80"
                    alt="Cinema screen movie poster"
                >
                <h3>Final Destination</h3>
                <p>Adventure | 2023</p>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h2>CINE<span>MAX</span></h2>

        <p>Your destination for movie information.</p>

        <p class="copyright">
            &copy; 2026 CINEMAX. All Rights Reserved.
        </p>
    </footer>

</body>
</html>
